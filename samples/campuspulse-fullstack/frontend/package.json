{
  "name": "campuspulse-fullstack-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CSC 436 Week 4 — React + axios client for the CampusPulse API.",
  "engines": { "node": ">=20.19" },
  "scripts": {
